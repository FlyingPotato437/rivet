# Public values only. This is embedded into the frontend at build time.
# Leave empty for local Vite /api proxy; set the hosted API origin on Vercel.
# No trailing /api: e.g. https://api.your-domain.com
VITE_API_URL=

# Clerk's publishable key is served by /api/auth/config. No secret key belongs
# in this file or in Vercel's frontend environment.

# Optional public contact fallback shown if the pilot form cannot save.
VITE_PILOT_EMAIL=
