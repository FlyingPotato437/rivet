# Copy to the repository root as .env.production ON THE SERVER, then fill it.
# Do not upload .env.production or production secrets to GitHub or Vercel.

# Generate a long hexadecimal password. URI punctuation must be percent-encoded;
# a hex password avoids differing Compose/URL escaping rules.
POSTGRES_PASSWORD=
RIVET_API_HOST=api.your-domain.com
RIVET_ALLOWED_HOSTS=api.your-domain.com,127.0.0.1,localhost
RIVET_ALLOWED_ORIGINS=https://app.your-domain.com

# Same PRODUCTION Clerk instance, with Organizations enabled.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional PEM public key; otherwise Clerk verifies with its configured instance.
CLERK_JWT_KEY=

# Optional. Comment intake/review/export work without these.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional email integration. Full-access key, verified sender and receiving
# subdomain, and a verified webhook are all needed before forwarding works.
RESEND_API_KEY=
RESEND_RECEIVING_DOMAIN=
RESEND_WEBHOOK_SECRET=
RIVET_EMAIL_FROM=

# compose.production.yml sets the production auth, database URL and data path.
# For another container host, also configure:
# RIVET_ENV=production
# RIVET_AUTH_MODE=clerk
# RIVET_LOCAL_ONLY=false
# RIVET_DEMO_ENABLED=false
# RIVET_DATABASE_URL=postgresql://...
# RIVET_DATA_DIR=/var/lib/rivet
