RIVET_DATABASE_URL=postgresql+psycopg://localhost:55432/rivet
RIVET_ENV=development
# Optional locally; required absolute mounted-volume path in production.
# RIVET_DATA_DIR=/var/lib/rivet
RIVET_LOCAL_ONLY=true
RIVET_PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RIVET_AGENT_MODEL=gpt-6-luna
# Orders opt in separately through Project instructions & limits.
RIVET_AGENT_AUTORUN=true

# Clerk CLI writes these to apps/web/.env.local, also loaded by the API.
# For a deployed API, set them in the server's environment instead.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key for networkless session verification.
CLERK_JWT_KEY=
# Auto-selects Clerk when configured; local mode is restricted to loopback.
# RIVET_AUTH_MODE=clerk
RIVET_ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178,http://127.0.0.1:8787,http://localhost:8787
RIVET_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Full access is required to retrieve received messages and their attachments.
RESEND_API_KEY=
RESEND_RECEIVING_DOMAIN=
RESEND_WEBHOOK_SECRET=
# An address on a verified sending domain, e.g. Rivet <notices@example.com>.
RIVET_EMAIL_FROM=

# Production: use deploy/.env.example and docs/deployment.md. Configure
# VITE_API_URL only in the frontend build environment (apps/web/.env.example).

# Production API remains closed until a private pilot deployment is ready.
# Local development defaults to enabled. Never turn this on to expose a public demo.
# RIVET_WORKSPACE_ENABLED=false
# Private authenticated workspace origin used by downloaded email briefs.
# Do not point this at the marketing-only site.
RIVET_WORKSPACE_URL=

# Private Microsoft 365 pilot. Configure an Exchange mailbox scope before granting
# application permissions. These are server-only; never put them in VITE_ variables.
RIVET_MS_TENANT_ID=
RIVET_MS_CLIENT_ID=
RIVET_MS_CLIENT_SECRET=
# Preferred alternative: mount the PEM certificate and its private key server-side.
# If either path is set, both are required; a bad certificate never falls back to a secret.
RIVET_MS_CERTIFICATE_PATH=
RIVET_MS_PRIVATE_KEY_PATH=
# JSON: {"rivet-organization-id":{"pm@example.com":{"update_recipient":"pm@example.com"}}}
RIVET_MS_MAILBOX_ALLOWLIST={}
# Internal PM briefs only; customer replies are always reviewed in Outlook.
RIVET_MAILBOX_UPDATES_ENABLED=false

# Server-only selected ERP/specification/vault bindings; see docs/connected-demo.md.
# No sources are accessible until an organization and job are explicitly mapped.
RIVET_CONNECTED_CONTEXT_CONFIG=

# Optional SAP Business Accelerator Hub sandbox. Server-only, read-only GET.
# Generic SAP samples remain separate from customer order evidence.
# See docs/sap-sandbox.md; a production SAP tenant needs its own authorization.
RIVET_SAP_API_KEY=

# Order autonomy v3: opt-in enterprise channels and publication targets.
# See docs/order-autonomy-v3.md. Empty values do not grant external access.
RIVET_VISION_ENABLED=true
RIVET_ENGINEERING_VISION_ENABLED=false
RIVET_ENGINEERING_VISION_MODEL=gpt-6.1-sol
RIVET_ENGINEERING_TEXT_MODEL=gpt-6.1-sol
RIVET_ENGINEERING_DRAWING_TIMEOUT_SECONDS=900
RIVET_ENGINEERING_TEXT_TIMEOUT_SECONDS=900
RIVET_ENGINEERING_DRAWING_OUTPUT_TOKENS=60000
RIVET_ENGINEERING_TEXT_OUTPUT_TOKENS=32000
RIVET_VISION_MAX_PAGES=40
RIVET_AGENT_COMMENT_TASKS=true
RIVET_FOLLOWUP_DRAFTS_ENABLED=false
RIVET_PUBLIC_WORKSPACE_URL=
RIVET_NOTIFICATION_BASE_URL=
RIVET_ACTIONABLE_ORIGINATOR=
RIVET_ACTIONABLE_AUDIENCE=
# JSON: {"microsoft-tenant-uuid:object-uuid":{"organization_id":"rivet-org-uuid","user_id":"Rivet user ID"}}
RIVET_ACTIONABLE_IDENTITIES={}
RIVET_INTERNAL_CHANNEL_CONFIG=
RIVET_WRITE_TARGETS_CONFIG=
